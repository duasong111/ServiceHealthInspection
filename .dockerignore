# ===== Python 编译产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
venv/
env/

# ===== 测试 / 文档 =====
.pytest_cache/
.tox/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
tests/
test/

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ===== 版本控制 =====
.git/
.gitignore
.gitattributes

# ===== 项目无关文件(进容器也用不到) =====
README.md
*.md
docs/
LICENSE
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.local.yml
.docker/

# ===== 敏感 / 运行时配置 =====
.env
.env.*
!.env.example
.envrc

# ===== 静态资源 / 媒体(让 Nginx / volume 挂) =====
staticfiles/
media/
static/

# ===== 临时文件 =====
*.log
*.tmp
*.bak
*.pid
nul
